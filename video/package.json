{
  "name": "clawgs-promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "clawGS feature promo video (HTML + GSAP timeline rendered to MP4 with Playwright + ffmpeg)",
  "type": "module",
  "scripts": {
    "preview": "node serve.mjs",
    "render": "node render.mjs",
    "render:draft": "node render.mjs --fps 15 --scale 0.5 --out out/clawGS-promo-draft.mp4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
